{
  "name": "solarops-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint src e2e --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../contracts/generated/openapi.json -o src/generated/schema.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "0.475.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.12",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.6",
    "openapi-typescript": "^7.10.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
