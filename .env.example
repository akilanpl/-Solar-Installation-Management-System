# Copy to .env at the repository root. These values are for local development only.
# Never put production credentials in this file or commit a filled-in .env.

SOLAROPS_APP_ENV=development
SOLAROPS_DATABASE_URL=postgresql+psycopg://solarops:solarops@127.0.0.1:5432/solarops_dev
# Disposable only: pytest drops this database's public schema. Never use solarops_dev here.
SOLAROPS_TEST_DATABASE_URL=postgresql+psycopg://solarops:solarops@127.0.0.1:5432/solarops_test
SOLAROPS_SECRET_KEY=replace-with-a-random-32-byte-development-secret
SOLAROPS_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SOLAROPS_COOKIE_SECURE=false
SOLAROPS_MAILBOX_PATH=var/dev-mailbox.jsonl

# Optional. If unset, `make seed` writes a password to var/dev-seed-password.txt.
# SOLAROPS_SEED_PASSWORD=

# Frontend build-time hint. The backend still decides whether the mailbox API exists.
NEXT_PUBLIC_SOLAROPS_ENV=development
SOLAROPS_API_ORIGIN=http://127.0.0.1:8000

# Optional SMTP. If unset in development, verification emails are captured locally.
# Production startup refuses the file mailbox. There is no fake SMTP success path.
# SOLAROPS_SMTP_HOST=
# SOLAROPS_SMTP_PORT=587
# SOLAROPS_SMTP_USERNAME=
# SOLAROPS_SMTP_PASSWORD=
# SOLAROPS_SMTP_FROM=solarops@localhost
# SOLAROPS_SMTP_TLS=true
